<style>
	body {
		margin: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		height: 100vh;
		background-color: #f3f3f3;
	}

	.magazine {
		width: 85%;
		height: 90%;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.magazine-layer {
		display: flex;
		width: 100%;
		height: 100%;
		box-shadow: 0 8px 15px rgba(0, 0, 0, 0.4);
		background-color: white;
		position: absolute;
		top: 0;
		left: 0;
		transform-origin: center;
	}

	/* Reducir tamaño progresivamente */
	.magazine-layer:nth-child(1) {
		transform: scaleX(0.99);
		background-color: #fff;
	}
	.magazine-layer:nth-child(2) {
		transform: scaleX(0.98);
		background-color: #fff;
	}
	.magazine-layer:nth-child(3) {
		transform: scaleX(0.97);
		background-color: #fff;
	}
	.magazine-layer:nth-child(4) {
		transform: scaleX(0.96);
		background-color: #fff;
	}
	.magazine-layer:nth-child(5) {
		transform: scaleX(0.95);
		background-color: #fff;
	}
	.magazine-layer:nth-child(6) {
		transform: scaleX(0.94);
		background-color: #fff;
	}
	.magazine-layer:nth-child(7) {
		transform: scaleX(0.93);
		background-color: #fff;
	}
	.magazine-layer:nth-child(8) {
		transform: scaleX(0.92);
		background-color: #fff;
	}
	.magazine-layer:nth-child(9) {
		transform: scaleX(0.91);
		background-color: #fff;
	}

	/* Página principal */
	.magazine-layer.main {
		transform: scaleX(0.92);
		z-index: 10;
	}

	.page {
		flex: 1;
		position: relative;
		overflow: hidden;
		background-size: cover;
		background-position: center;
		display: grid;
		grid-template-columns: 1fr;
		grid-template-rows: 1fr 1fr;

		.row img {
			height: 100%;
			width: 100%;
			object-fit: cover;
		}
	}

	
	.page.left {
		border-right: 2px solid #ddd;
		box-shadow: 5px 0 20px rgba(0, 0, 0, 0.5);
		
		
	}

	.row {
		height: 100%;
		overflow: hidden;
		position: relative;
	}

	.page.right {
		box-shadow: -5px 0 10px rgba(0, 0, 0, 0.5);
	}



</style>

<div class="magazine">
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>
	<div class="magazine-layer down"></div>

	<div class="magazine-layer main">
		<div class="page left">
			<div class="row">
				<img src="paula.jpg" alt="">
			</div>
			
			<div class="row">
				<img src="letrasSVG/PAULA.svg" alt="">		
			</div>
							

		</div>
		<div class="page right">
			<div class="row">
				<img src="letrasSVG/PAULA.svg" alt="">		
			</div>
			
			<div class="row">
				<img src="paula2.jpeg" alt="">
			</div>
		</div>
	</div>
</div>
